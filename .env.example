# API relative en développement : le proxy Vite évite le CORS.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8002
VITE_BASE_PATH=/
# Cookie de session : utiliser le même site (ex. crm.comsig.ci et api.comsig.ci)
# ou un proxy de même origine. Un domaine vercel.app séparé ne suffit pas.
# Si l'API est dans un sous-répertoire, adapter aussi VITE_CSRF_URL.
# VITE_CSRF_URL=/sanctum/csrf-cookie
# Ne JAMAIS mettre de mot de passe, jeton ou clé privée dans VITE_*.
