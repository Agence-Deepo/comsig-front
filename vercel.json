{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://testerp.com-sig.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://testerp.com-sig.com/sanctum/:path*" },
    { "source": "/((?!assets/|favicon.svg).*)", "destination": "/index.html" }
  ]
}
